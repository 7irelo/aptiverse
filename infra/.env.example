# =============================================================================
# Aptiverse environment variables
# =============================================================================
# Local dev: copy to .env in this directory; `docker compose up -d` reads it
# Prod (EC2): copy to /opt/aptiverse/.env on the box; compose.prod.yml reads it
# =============================================================================

# ---------------------------------------------------------------------------
# Postgres (LOCAL DEV ONLY — prod uses RDS via DB_CONNECTION_STRING)
# ---------------------------------------------------------------------------
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Database connection string (.NET format) — used by the API in both envs
#   Local: Host=localhost;Port=5432;Database=aptiverse;Username=pgadmin;Password=...
#   Prod:  paste the value of  `terraform output -raw db_connection_string`
# ---------------------------------------------------------------------------
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=aptiverse;Username=pgadmin;Password=CHANGE_ME

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_KEY=CHANGE_ME_AT_LEAST_256_BITS
JWT_ISSUER=https://aptiverse.co.za
JWT_AUDIENCE=aptiverse

# ---------------------------------------------------------------------------
# Email (SES SMTP — verify the domain at ses.console first)
# ---------------------------------------------------------------------------
EMAIL_SMTP_HOST=email-smtp.af-south-1.amazonaws.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=CHANGE_ME
EMAIL_SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM_ADDRESS=noreply@aptiverse.co.za

# ---------------------------------------------------------------------------
# OAuth (leave blank until Google/Apple credentials are provisioned)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
