# Copy to .env.local and fill in. Never commit real values.

# Base URL of the Aptiverse API, used by Server Components and the /api/bff
# proxy. Local API: http://localhost:5100
API_INTERNAL_URL=http://localhost:5100

# Optional: pinned OpenAPI spec URL for `npm run api:sync`. When empty the
# script copies ../api/openapi/v1.json if that checkout exists.
API_SPEC_URL=

# Environment name shown in Sentry (local, preview, dev, staging, prod).
NEXT_PUBLIC_APP_ENV=local

# Sentry. Leave the DSN empty to keep Sentry switched off.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload (set in Vercel, not locally).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Auth.js session encryption key (Secrets Manager aptiverse/<env>/auth-session).
# Generate with `npx auth secret`. For rotation, list new,old comma separated.
AUTH_SECRET=

# Google sign-in (optional). Leave empty to hide "Continue with Google".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin(s) of the web app, comma separated, for the BFF CSRF check.
# Defaults to the request's own origin. Example: https://aptiverse.co.za
APP_ORIGIN=

# Where the visitor IP comes from for API rate limits: x-real-ip (Vercel),
# x-forwarded-for-last (behind a load balancer) or none.
CLIENT_IP_SOURCE=x-real-ip

# Local production builds over plain http (Playwright) need non-Secure
# cookies. Never set this on a deployed environment.
APTIVERSE_INSECURE_COOKIES=
