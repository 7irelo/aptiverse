<!DOCTYPE html>
<html lang="en-ZA" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f3f1;color:#141519;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f2f3f1;">
<tr>
<td align="center" style="padding:24px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#ffffff;border:1px solid #e3e5e1;border-radius:12px;">
<tr>
<td style="padding:24px 32px 0 32px;">
<p style="margin:0;font-size:20px;font-weight:700;color:#141519;">{{ brand }}</p>
</td>
</tr>
<tr>
<td style="padding:16px 32px 8px 32px;color:#141519;">
{{ content }}
</td>
</tr>
<tr>
<td style="padding:16px 32px 24px 32px;border-top:1px solid #e3e5e1;color:#4b4e4a;font-size:13px;">
<p style="margin:0 0 8px 0;">You are receiving this email because it is about your {{ brand }} account. We send these messages even if you have turned off other emails.</p>
<p style="margin:0;"><a href="{{ home_link }}" style="color:#141519;text-decoration:underline;">{{ brand }}</a></p>
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
