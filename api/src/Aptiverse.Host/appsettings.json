{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Wolverine": "Warning",
      "JasperFx": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Aptiverse": ""
  },
  "Auth": {
    "Issuer": "https://api.aptiverse.co.za",
    "Audience": "aptiverse-web",
    "WebAppUrl": "https://aptiverse.co.za"
  },
  "AiService": {
    "BaseUrl": "http://ai.aptiverse.internal:8080",
    "Audience": "aptiverse-ai",
    "TimeoutSeconds": 120,
    "DailyMessageLimit": 100,
    "MaxMessageChars": 4000,
    "HistoryTurns": 20
  },
  "Legal": {
    "TermsVersion": "2026-10-19",
    "PrivacyVersion": "2026-10-19",
    "TermsUrl": "https://aptiverse.co.za/terms",
    "PrivacyUrl": "https://aptiverse.co.za/privacy",
    "EffectiveFrom": "2026-10-19"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Messaging": {
    "Schema": "wolverine",
    "AutoBuildStorage": false,
    "SoloMode": false
  },
  "Telemetry": {
    "ConsoleExporter": false
  },
  "Sentry": {
    "Dsn": ""
  }
}
