<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Aptiverse.Host</RootNamespace>
    <UserSecretsId>aptiverse-host</UserSecretsId>
    <!-- Build-time OpenAPI: writes openapi/v1.json at the repo root on build. CI fails if it drifts. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aptiverse.SharedKernel\Aptiverse.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Academics\Aptiverse.Academics\Aptiverse.Academics.csproj" />
    <ProjectReference Include="..\Modules\AiTutor\Aptiverse.AiTutor\Aptiverse.AiTutor.csproj" />
    <ProjectReference Include="..\Modules\Billing\Aptiverse.Billing\Aptiverse.Billing.csproj" />
    <ProjectReference Include="..\Modules\Identity\Aptiverse.Identity\Aptiverse.Identity.csproj" />
    <ProjectReference Include="..\Modules\Mcp\Aptiverse.Mcp\Aptiverse.Mcp.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Aptiverse.Notifications\Aptiverse.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Practice\Aptiverse.Practice\Aptiverse.Practice.csproj" />
    <ProjectReference Include="..\Modules\Progress\Aptiverse.Progress\Aptiverse.Progress.csproj" />
    <ProjectReference Include="..\Modules\Support\Aptiverse.Support\Aptiverse.Support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

</Project>
