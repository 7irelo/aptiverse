# Copy to .env and fill in. The API reads this file at startup in Development
# (see the loader at the top of Program.cs); a value already present in the
# real environment always wins, so a deployed host is never overwritten by a
# stale local file. .env is gitignored; this template is committed and must
# never carry a real value.

# --- Database (reached through the SSH tunnel to RDS on localhost:5432) ---
ConnectionStrings__DefaultConnection=

# --- Paystack billing ---
PAYSTACK_SECRET_KEY=

# --- Google OAuth ---
Authentication__Google__ClientId=

# --- Outbound email (Amazon SES over SMTP) ---
EmailSettings__Server=
EmailSettings__Port=
EmailSettings__Username=
EmailSettings__Password=

# --- Anthropic (tutor, practice generation, exam marking) ---
ANTHROPIC_API_KEY=

# --- Server-side conversion reporting (Meta Conversions API) -----------------
#
# Optional. Leave both blank and the billing flow is completely unaffected:
# MetaConversionsClient.IsConfigured reads false and every call is a no-op.
#
# META_PIXEL_ID: the SAME numeric id the browser uses as
# NEXT_PUBLIC_META_PIXEL_ID in the web app. It has to match, or the server
# events and the browser events land on two different datasets and neither
# number is trustworthy.
META_PIXEL_ID=

# META_CAPI_ACCESS_TOKEN: a system-user access token generated in Meta Events
# Manager under the dataset's Settings > Conversions API > Generate access
# token. THIS ONE IS A SECRET. Anyone holding it can write events into the ad
# account's dataset, so treat it like the Paystack key: never in the repo,
# never in a client bundle, never in a log line.
META_CAPI_ACCESS_TOKEN=

# META_TEST_EVENT_CODE: optional, e.g. TEST12345. Set it temporarily to route
# events to the Test Events tab in Events Manager so a purchase can be watched
# arriving live without polluting real campaign data. REMOVE IT afterwards:
# left set in production, every real purchase is filed as a test.
META_TEST_EVENT_CODE=
