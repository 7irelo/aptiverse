{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
    }
  },
  "EnableDevelopmentCors": true,
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=aptiverse;Username=postgres;Password=password",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "Key": "dev-only-jwt-secret-not-for-production-must-be-at-least-32-chars",
    "Issuer": "aptiverse-api",
    "Audience": "aptiverse-users",
    "ExpireHours": 4
  }
}
