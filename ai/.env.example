# Copy to .env for local dev. In dev, the database is reached through the SSH
# tunnel to RDS (localhost:5432) opened by ../api/start-dev.ps1. In prod the
# service runs inside the VPC and talks to RDS directly.

# --- Database (same Postgres as the .NET API) ---
# Note the +asyncpg driver. Through the dev SSH tunnel this is localhost:5432.
AI_DATABASE_URL=postgresql+asyncpg://aptiverse_admin:CHANGE_ME@localhost:5432/aptiverse

# --- Redis (shared with the API: cache, Arq queue, outbox pub/sub) ---
AI_REDIS_URL=redis://localhost:6379/1

# --- OpenAI (the ONLY paid LLM dependency — chatbot only) ---
AI_OPENAI_API_KEY=CHANGE_ME
AI_OPENAI_MODEL=gpt-4o

# --- Behaviour ---
AI_ENV=development
AI_LOG_LEVEL=INFO
# Channel the .NET transactional outbox publishes recompute events on.
AI_OUTBOX_CHANNEL=aptiverse.events
# Model artifact version stamped onto every analytics row written.
AI_MODEL_VERSION=2026.06.0
