# =============================================================================
# Aptiverse Dev Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# .NET connection string format
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=aptiverse;Username=pgadmin;Password=CHANGE_ME_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
JWT_KEY=CHANGE_ME_GENERATE_A_SECURE_KEY_AT_LEAST_256_BITS
JWT_ISSUER=https://dev.aptiverse.co.za
JWT_AUDIENCE=aptiverse

# ---------------------------------------------------------------------------
# Email (Auth Provider)
# ---------------------------------------------------------------------------
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@aptiverse.co.za
EMAIL_SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM_ADDRESS=noreply@aptiverse.co.za

# ---------------------------------------------------------------------------
# UI (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_SECURE_SECRET
